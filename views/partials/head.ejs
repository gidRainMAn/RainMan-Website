<head>
    <!-- Google Tag Manager -->
    <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','GTM-N3TBPNV');</script>
    <!-- End Google Tag Manager -->
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title><%= typeof title !== "undefined" ? title : "RainMan" %></title>

    <meta
        name="description"
        content="<%= typeof description !== 'undefined' ? description : '' %>"
    >

    <meta
        name="robots"
        content="<%= typeof robots !== 'undefined' ? robots : 'index,follow' %>"
    >

    <link
        rel="canonical"
        href="https://www.therainman.in<%= typeof canonical !== 'undefined' ? canonical : '/' %>"
    >

    <!-- Open Graph -->
    <meta
        property="og:title"
        content="<%= typeof title !== 'undefined' ? title : 'RainMan' %>"
    >

    <meta
        property="og:description"
        content="<%= typeof description !== 'undefined' ? description : '' %>"
    >

    <meta
        property="og:type"
        content="website"
    >

    <meta
        property="og:url"
        content="https://www.therainman.in<%= typeof canonical !== 'undefined' ? canonical : '/' %>"
    >
    
    <link rel="icon" href="/images/rainManLogo.png">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link
        href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Oswald:wght@400;500;600;700&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap"
        rel="stylesheet"
    >

    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/responsive.css">
    <% if (typeof pageCSS !== 'undefined') { %>
        <link rel="stylesheet" href="/css/<%= pageCSS %>.css">
    <% } %>

    <% if (typeof currentPage !== 'undefined' && currentPage === 'contact') { %>
        <script
            src="https://challenges.cloudflare.com/turnstile/v0/api.js"
            async
            defer
        ></script>
    <% } %>

</head>
