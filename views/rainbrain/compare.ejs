<!doctype html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>RainBrain vs Robyn vs Meridian — MMM comparison | RainMan</title>
  <meta name="description"
    content="How RainBrain compares with open-source MMM frameworks Robyn (Meta) and Meridian (Google) on usability, speed, control and support.">
  <link rel="icon" href="assets/RainMan_Logo.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Poppins:wght@500;600;700&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap"
    rel="stylesheet">
  <style>
    :root {
      --green: #4CA82F;
      --green-d: #3d8a26;
      --blue: #0072C0;
      --blue-d: #005c9c;
      --ink: #16242c;
      --slate: #54646e;
      --line: #e6ebee;
      --bg: #ffffff;
      --bg-soft: #f5f8f6;
      --bg-tint: #eef5f1;
      --mid: #268d78;
      --radius: 16px;
      --maxw: 1140px;
      --grad: linear-gradient(90deg, var(--green), var(--mid) 52%, var(--blue));
    }

    * {
      box-sizing: border-box
    }

    html {
      scroll-behavior: smooth
    }

    body {
      margin: 0;
      font-family: Inter, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif;
      color: var(--ink);
      background: var(--bg);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased
    }

    h1,
    h2,
    h3,
    h4 {
      font-family: Poppins, Inter, sans-serif;
      line-height: 1.12;
      margin: 0 0 .4em;
      letter-spacing: -.01em
    }

    h1 {
      font-size: clamp(2.1rem, 4.6vw, 3.5rem);
      font-weight: 700
    }

    h2 {
      font-size: clamp(1.6rem, 3vw, 2.3rem);
      font-weight: 700
    }

    h3 {
      font-size: 1.18rem;
      font-weight: 600
    }

    p {
      margin: 0 0 1rem
    }

    a {
      color: var(--blue);
      text-decoration: none
    }

    .wrap {
      max-width: var(--maxw);
      margin: 0 auto;
      padding: 0 24px
    }

    .eyebrow {
      font-family: Poppins, sans-serif;
      font-weight: 600;
      font-size: .78rem;
      letter-spacing: .14em;
      text-transform: uppercase;
      color: var(--green)
    }

    .lead {
      font-size: 1.18rem;
      color: var(--slate);
      max-width: 60ch
    }

    .grad-text {
      background: var(--grad);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent
    }

    /* header */
    header.site {
      position: sticky;
      top: 0;
      z-index: 50;
      background: rgba(255, 255, 255, .92);
      backdrop-filter: saturate(1.4) blur(10px);
      border-bottom: 1px solid var(--line)
    }

    .nav {
      display: flex;
      align-items: center;
      gap: 28px;
      height: 74px
    }

    .brand svg.logo-h {
      height: 40px;
      width: auto;
      display: block
    }

    .nav .links {
      display: flex;
      gap: 26px;
      margin-left: auto;
      align-items: center
    }

    .nav .links a.navlink {
      color: var(--ink);
      font-weight: 500;
      font-size: .95rem
    }

    .nav .links a.navlink:hover {
      color: var(--blue)
    }

    .nav .rm {
      font-size: .82rem;
      color: var(--slate)
    }

    .btn {
      display: inline-block;
      font-family: Poppins, sans-serif;
      font-weight: 600;
      border-radius: 999px;
      padding: .7rem 1.25rem;
      font-size: .95rem;
      border: 2px solid transparent;
      cursor: pointer;
      transition: .15s
    }

    .btn-primary {
      background: var(--blue);
      color: #fff
    }

    .btn-primary:hover {
      background: var(--blue-d)
    }

    .btn-green {
      background: var(--green);
      color: #fff
    }

    .btn-green:hover {
      background: var(--green-d)
    }

    .btn-ghost {
      border-color: var(--line);
      color: var(--ink);
      background: #fff
    }

    .btn-ghost:hover {
      border-color: var(--blue);
      color: var(--blue)
    }

    .menu-toggle {
      display: none
    }

    /* hero */
    .hero {
      position: relative;
      overflow: hidden;
      background:
        radial-gradient(900px 420px at 88% -10%, rgba(0, 114, 192, .10), transparent 60%),
        radial-gradient(720px 400px at 6% 8%, rgba(76, 168, 47, .10), transparent 60%);
      padding: 84px 0 72px
    }

    .hero .logo-big {
      height: 96px;
      width: auto;
      margin-bottom: 30px
    }

    .hero .actions {
      display: flex;
      gap: 14px;
      flex-wrap: wrap;
      margin-top: 26px
    }

    .hero .note {
      margin-top: 16px;
      color: var(--slate);
      font-size: .92rem
    }

    /* sections */
    section.block {
      padding: 72px 0
    }

    section.soft {
      background: var(--bg-soft)
    }

    .section-head {
      max-width: 62ch
    }

    .center {
      text-align: center;
      margin-left: auto;
      margin-right: auto
    }

    /* cards */
    .grid {
      display: grid;
      gap: 22px
    }

    .g3 {
      grid-template-columns: repeat(3, 1fr)
    }

    .g2 {
      grid-template-columns: repeat(2, 1fr)
    }

    .g4 {
      grid-template-columns: repeat(4, 1fr)
    }

    .card {
      background: #fff;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      padding: 26px;
      transition: .18s;
      height: 100%
    }

    .card:hover {
      transform: translateY(-3px);
      box-shadow: 0 14px 36px rgba(20, 40, 50, .08);
      border-color: #dfeae3
    }

    .card .ico {
      width: 46px;
      height: 46px;
      border-radius: 12px;
      display: grid;
      place-items: center;
      margin-bottom: 14px;
      background: var(--bg-tint);
      color: var(--green)
    }

    .card.blue .ico {
      color: var(--blue);
      background: #e7f1fa
    }

    .card h3 {
      margin-bottom: .35em
    }

    .card p {
      color: var(--slate);
      margin: 0
    }

    /* stat strip */
    .stats {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 22px;
      text-align: center
    }

    .stat .n {
      font-family: Poppins, sans-serif;
      font-weight: 700;
      font-size: 2rem;
      background: var(--grad);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent
    }

    .stat .l {
      color: var(--slate);
      font-size: .95rem
    }

    /* split / highlight */
    .split {
      display: grid;
      grid-template-columns: 1.05fr .95fr;
      gap: 48px;
      align-items: center
    }

    .panel {
      background: var(--ink);
      color: #dfe7eb;
      border-radius: 22px;
      padding: 34px
    }

    .panel h3 {
      color: #fff
    }

    .panel ul {
      margin: 0;
      padding-left: 0;
      list-style: none
    }

    .panel li {
      padding: 10px 0 10px 30px;
      position: relative;
      border-bottom: 1px solid rgba(255, 255, 255, .08)
    }

    .panel li:last-child {
      border-bottom: 0
    }

    .panel li::before {
      content: "";
      position: absolute;
      left: 0;
      top: 17px;
      width: 12px;
      height: 12px;
      border-radius: 3px;
      background: var(--grad)
    }

    /* steps */
    .steps {
      counter-reset: s;
      display: grid;
      gap: 18px
    }

    .step {
      display: grid;
      grid-template-columns: 54px 1fr;
      gap: 18px;
      align-items: start;
      background: #fff;
      border: 1px solid var(--line);
      border-radius: 14px;
      padding: 20px 22px
    }

    .step .num {
      counter-increment: s;
      font-family: Poppins, sans-serif;
      font-weight: 700;
      color: #fff;
      width: 46px;
      height: 46px;
      border-radius: 12px;
      display: grid;
      place-items: center;
      background: var(--grad)
    }

    .step .num::before {
      content: counter(s)
    }

    .step h3 {
      margin: .1em 0 .25em
    }

    .step p {
      margin: 0;
      color: var(--slate)
    }

    /* table */
    .tablewrap {
      position: relative;
      overflow: hidden;
      overflow-x: auto;
      border: 1px solid var(--line);
      border-radius: 16px;
      box-shadow: 0 20px 48px rgba(20, 40, 50, .08)
    }

    table.cmp {
      border-collapse: collapse;
      width: 100%;
      min-width: 760px;
      background: #fff
    }

    table.cmp th,
    table.cmp td {
      padding: 18px 22px;
      text-align: left;
      border-bottom: 1px solid var(--line);
      vertical-align: top;
      font-size: .95rem;
      line-height: 1.55
    }

    table.cmp thead th {
      font-family: Poppins, sans-serif;
      font-weight: 700;
      font-size: 1rem;
      color: #fff;
      background: var(--ink);
      padding-top: 18px;
      padding-bottom: 18px;
      vertical-align: middle;
      line-height: 1;
      white-space: nowrap;
      border-bottom: none
    }

    table.cmp thead th.rb {
      background: var(--green-d);
      color: #fff
    }

    table.cmp thead th .tag {
      white-space: nowrap;
      margin-left: 8px;
      vertical-align: middle
    }

    table.cmp thead th:not(.rb) .tag {
      background: rgba(255, 255, 255, .14);
      color: rgba(255, 255, 255, .82)
    }

    table.cmp thead th.rb .rb-tag {
      background: #fff;
      color: var(--green-d)
    }

    table.cmp td.dim {
      font-weight: 600;
      color: var(--ink);
      width: 21%;
      background: var(--bg-soft)
    }

    table.cmp td.rb {
      background: rgba(76, 168, 47, .055);
      font-weight: 500
    }

    table.cmp th.rb,
    table.cmp td.rb {
      box-shadow: inset 1px 0 0 rgba(76, 168, 47, .35), inset -1px 0 0 rgba(76, 168, 47, .35)
    }

    table.cmp tbody tr:hover td {
      background-color: rgba(0, 114, 192, .04)
    }

    table.cmp tbody tr:hover td.rb {
      background-color: rgba(76, 168, 47, .13)
    }

    table.cmp tr:last-child td {
      border-bottom: 0
    }

    table.cmp thead th:first-child {
      border-top-left-radius: 16px
    }

    table.cmp thead th:last-child {
      border-top-right-radius: 16px
    }

    .tag {
      display: inline-block;
      font-size: .7rem;
      font-weight: 600;
      font-family: Poppins, sans-serif;
      padding: .2rem .6rem;
      border-radius: 999px;
      background: var(--bg-tint);
      color: var(--green-d)
    }

    /* CTA band */
    .cta {
      background: var(--grad);
      border-radius: 24px;
      padding: 46px;
      color: #fff;
      text-align: center
    }

    .cta h2 {
      color: #fff
    }

    .cta p {
      color: rgba(255, 255, 255, .92);
      max-width: 52ch;
      margin: 0 auto 22px
    }

    .cta .btn-ghost {
      background: rgba(255, 255, 255, .14);
      border-color: rgba(255, 255, 255, .5);
      color: #fff
    }

    .cta .btn-ghost:hover {
      background: rgba(255, 255, 255, .24)
    }

    .cta .btn-white {
      background: #fff;
      color: var(--blue)
    }

    /* form */
    .form {
      background: #fff;
      border: 1px solid var(--line);
      border-radius: 18px;
      padding: 30px;
      max-width: 560px
    }

    .form label {
      display: block;
      font-weight: 600;
      font-size: .9rem;
      margin: 14px 0 6px
    }

    .form input,
    .form select,
    .form textarea {
      width: 100%;
      padding: 12px 14px;
      border: 1px solid var(--line);
      border-radius: 10px;
      font: inherit;
      color: var(--ink)
    }

    .form .row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px
    }


    /* command bands & figures */
    .band {
      position: relative;
      color: #fff;
      padding: 92px 0;
      background-size: cover;
      background-position: center;
      background-color: #0a141f
    }

    .band::before,
    .band::after {
      content: "";
      position: absolute;
      left: 0;
      right: 0;
      height: 3px;
      background: var(--grad);
      z-index: 1
    }

    .band::before {
      top: 0
    }

    .band::after {
      bottom: 0
    }

    .band .kicker {
      font-family: 'IBM Plex Mono', monospace;
      font-size: .74rem;
      letter-spacing: .3em;
      text-transform: uppercase;
      color: #8fd0a8;
      margin: 0 0 16px
    }

    .band h2 {
      color: #fff;
      max-width: 24ch
    }

    .band .lead {
      color: rgba(255, 255, 255, .86)
    }

    .band .coords {
      margin-top: 34px;
      font-family: 'IBM Plex Mono', monospace;
      font-size: .7rem;
      letter-spacing: .2em;
      color: rgba(255, 255, 255, .55)
    }

    .band .bstats {
      display: flex;
      gap: 48px;
      flex-wrap: wrap;
      margin-top: 36px
    }

    .band .bstat .n {
      font-family: Poppins, sans-serif;
      font-weight: 700;
      font-size: 1.55rem;
      background: var(--grad);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent
    }

    .band .bstat .l {
      color: rgba(255, 255, 255, .72);
      font-size: .9rem;
      margin-top: 2px
    }

    .band-slim {
      padding: 58px 0
    }

    /* command band: dark gradient + faint grid + a quiet radar accent, no static photo */
    .cc-band {
      background: linear-gradient(100deg, #050c15 0%, #050c15 32%, #0a1420 58%, #0c1a26 100%), radial-gradient(1200px 600px at 85% 15%, rgba(0, 114, 192, .18), transparent 60%), linear-gradient(135deg, #050d16 0%, #0a1420 55%, #0c1a26 100%)
    }

    .cc-field {
      position: absolute;
      inset: 0;
      overflow: hidden;
      pointer-events: none;
      z-index: 1
    }

    .cc-grid {
      position: absolute;
      inset: 0;
      opacity: .32;
      background-image: radial-gradient(circle, rgba(111, 204, 231, .2) 1px, transparent 1.2px);
      background-size: 34px 34px;
      -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 38%, #000 100%);
      mask-image: linear-gradient(90deg, transparent 0%, #000 38%, #000 100%)
    }

    .cc-radar {
      position: absolute;
      right: 9%;
      top: 20%;
      width: 140px;
      aspect-ratio: 1;
      opacity: .5;
      border: 1px solid rgba(129, 207, 232, .32);
      border-radius: 50%;
      z-index: 1
    }

    .cc-radar::before,
    .cc-radar::after {
      content: '';
      position: absolute;
      background: rgba(129, 207, 232, .3)
    }

    .cc-radar::before {
      left: 50%;
      top: -30px;
      bottom: -30px;
      width: 1px;
      transform: translateX(-50%)
    }

    .cc-radar::after {
      top: 50%;
      left: -30px;
      right: -30px;
      height: 1px;
      transform: translateY(-50%)
    }

    .cc-radar i {
      position: absolute;
      border: 1px solid rgba(129, 207, 232, .26);
      border-radius: 50%;
      inset: 22%
    }

    .cc-radar i:nth-child(2) {
      inset: 44%
    }

    .cc-radar i:nth-child(3) {
      inset: 0;
      border-color: transparent;
      border-top-color: rgba(76, 168, 47, .85);
      transform: rotate(-20deg);
      animation: ccSweep 4s linear infinite
    }

    .cc-radar b {
      position: absolute;
      top: 50%;
      left: 50%;
      width: 7px;
      height: 7px;
      margin: -3.5px 0 0 -3.5px;
      border-radius: 50%;
      background: #4CA82F;
      box-shadow: 0 0 12px #4CA82F
    }

    @keyframes ccSweep {
      to {
        transform: rotate(340deg)
      }
    }

    @media(max-width:860px) {
      .cc-radar {
        opacity: .35
      }
    }

    .figure {
      border: 1px solid var(--line);
      border-radius: var(--radius);
      overflow: hidden;
      background: #fff;
      box-shadow: 0 16px 40px rgba(20, 40, 50, .10)
    }

    .figure img {
      display: block;
      width: 100%;
      height: auto
    }

    .figure figcaption {
      font-family: 'IBM Plex Mono', monospace;
      font-size: .7rem;
      letter-spacing: .14em;
      text-transform: uppercase;
      color: var(--slate);
      padding: 11px 16px;
      border-top: 1px solid var(--line);
      margin: 0
    }

    @media(max-width:860px) {
      .band {
        padding: 60px 0
      }

      .band .bstats {
        gap: 26px
      }
    }

    /* footer */
    footer.site {
      background: #0e1116;
      color: #aeb9c0;
      padding: 54px 0 30px;
      margin-top: 10px
    }

    footer.site .cols {
      display: grid;
      grid-template-columns: 1.4fr 1fr 1fr;
      gap: 36px
    }

    footer.site h4 {
      color: #fff;
      font-size: .95rem;
      letter-spacing: .04em;
      margin-bottom: 14px
    }

    footer.site a {
      color: #aeb9c0;
      display: block;
      padding: 5px 0;
      font-size: .92rem
    }

    footer.site a:hover {
      color: #fff
    }

    footer.site .parent {
      display: flex;
      align-items: center;
      gap: 14px;
      margin-top: 14px
    }

    footer.site .parent img {
      height: 34px
    }

    footer.site .legal {
      border-top: 1px solid #20272e;
      margin-top: 34px;
      padding-top: 18px;
      display: flex;
      justify-content: space-between;
      gap: 14px;
      flex-wrap: wrap;
      font-size: .85rem;
      color: #7d8a92
    }

    @media(max-width:860px) {
      .nav .links {
        display: none
      }

      .g3,
      .g4,
      .g2,
      .stats,
      .split,
      footer.site .cols {
        grid-template-columns: 1fr
      }

      .split {
        gap: 28px
      }

      .stats {
        grid-template-columns: 1fr 1fr;
        gap: 26px
      }

      section.block {
        padding: 54px 0
      }
    }
  </style>
</head>

<body>
  <header class="site">
    <div class="wrap nav">
      <a class="brand" href="/rainbrain/" aria-label="RainBrain home"><svg class="logo-h"
          xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1102.8 265.0" role="img" aria-label="RainBrain logo">
          <g transform="translate(60.0,11.7) scale(0.6905)">
            <g transform="translate(-44.27,-23.86)">
              <defs>
                <linearGradient id="lg_head" x1="50" y1="0" x2="350" y2="0" gradientUnits="userSpaceOnUse">
                  <stop offset="0" stop-color="#4CA82F" />
                  <stop offset="0.5" stop-color="#268D78" />
                  <stop offset="1" stop-color="#0072C0" />
                </linearGradient>
