<section class="img-band img-band-top resources-hero"
    style="padding:0; min-height:420px; display:flex; align-items:center;">
    <div class="resources-hero-photo"
        style="background-image:url('/images/resources1.png'); background-position:center 35%;"></div>
    <div class="resources-hero-tint"
        style="background-image:linear-gradient(100deg,rgba(15,9,3,.95) 0%,rgba(16,10,4,.86) 28%,rgba(16,10,4,.55) 55%,rgba(16,10,4,.28) 78%,rgba(16,10,4,.58) 100%),radial-gradient(ellipse 120% 95% at 50% 50%,rgba(10,6,2,.15) 52%,rgba(6,4,1,.55) 100%);">
    </div>
    <div class="resources-hero-sweep"></div>
    <div class="container img-band-inner" style="width:100%;">
        <div style="max-width:560px;">
            <div class="eyebrow" style="color:#e3c98f;">Debrief</div>
            <h2 style="color:#fff;">How some marketing skirmishes were won through data.</h2>
            <p style="color:rgba(255,255,255,.80);">Case studies, whitepapers and field notes drawn from RainMan's
                intuition, experience and 15+ years of cross-category pattern recognition.</p>
        </div>
    </div>
</section>

<section id="case-studies">
    <div class="container">

        <div class="section-head">
            <div class="eyebrow">Case files</div>
            <h2>How RainMan helped brands move ahead of competition</h2>
        </div>

        <div class="filter-row">
            <button class="filter-btn active" data-filter="all">All</button>
            <button class="filter-btn" data-filter="Marketing">Marketing</button>
            <button class="filter-btn" data-filter="Media">Media</button>
            <button class="filter-btn" data-filter="Retail">Retail</button>
            <button class="filter-btn" data-filter="Sales">Sales</button>
            <button class="filter-btn" data-filter="Creative">Creative</button>
            <button class="filter-btn" data-filter="Digital">Digital</button>
            <button class="filter-btn" data-filter="Research">Research</button>
        </div>

        <div class="grid grid-3">

            <% if(caseStudies && caseStudies.items && caseStudies.items.length){ %>

                <% caseStudies.items.forEach(item=> { %>

                    <div class="card case-card">

                        <span class="tag">
                            <%= item.category || "Case Study" %>
                        </span>

                        <h3>
                            <a href="/resources/<%= item.slug %>">
                                <%= item.title %>
                            </a>
                        </h3>

                        <p>
                            <%= item.excerpt %>
                        </p>

                    </div>

                    <% }) %>

                        <% } else { %>

                            <p>No Case Studies found.</p>

                            <% } %>

        </div>

        <% if(caseStudies.totalPages> 1){ %>

            <div class="pagination">

                <% for(let i=1;i<=caseStudies.totalPages;i++){ %>

                    <a href="/resources?casePage=<%= i %>&whitePage=<%= whitepapers.page %>&blogPage=<%= blogs.page %>"
                        class="<%= caseStudies.page === i ? 'active' : '' %>">

                        <%= i %>

                    </a>

                    <% } %>

            </div>

            <% } %>

    </div>
</section>

<section id="white-papers" class="bg-dim">

    <div class="container">

        <div class="section-head">
            <div class="eyebrow">Whitepapers</div>
            <h2>To keep you ahead, information and intelligence is the key</h2>
        </div>

        <div class="grid grid-3">
            <% if(whitepapers && whitepapers.items && whitepapers.items.length){ %>

                <% whitepapers.items.forEach(item=> { %>

                    <div class="card">

                        <span class="tag">
                            Whitepaper
                        </span>

                        <h3 style="margin-top:14px;font-size:1.05rem;">

                            <a href="/resources/<%= item.slug %>">

                                <%= item.title %>

                            </a>

                        </h3>

                    </div>

                    <% }) %>

                        <% } else { %>

                            <p>No Whitepapers available.</p>

                            <% } %>

        </div>

        <% if(whitepapers.totalPages> 1){ %>

            <div class="pagination">

                <% for(let i=1;i<=whitepapers.totalPages;i++){ %>

                    <a href="?casePage=<%= caseStudies.page %>&whitePage=<%= i %>&blogPage=<%= blogs.page %>"
                        class="<%= whitepapers.page === i ? 'active' : '' %>">

                        <%= i %>

                    </a>

                    <% } %>

            </div>

            <% } %>

    </div>

</section>

<section id="blog">

    <div class="container" style="max-width:900px;">

        <div class="section-head">

            <div class="eyebrow">
                Field notes
            </div>

            <h2>
                Latest thinking from the RainMan team
            </h2>

        </div>
        <% if(blogs && blogs.items && blogs.items.length){ %>

            <% blogs.items.forEach(blog=> { %>

                <div class="blog-card">

                    <a href="/resources/<%= blog.slug %>" class="blog-card">

                        <h3>
                            <%= blog.title %>
                        </h3>

                        <p>
                            <%= blog.excerpt %>
                        </p>

                    </a>

                    <span class="byline">
                        RainMan
                    </span>

                </div>

                <% }) %>

                    <% } else { %>

                        <p>No articles published yet.</p>

                        <% } %>

                            <% if(blogs.totalPages> 1){ %>

                                <div class="pagination">

                                    <% for(let i=1;i<=blogs.totalPages;i++){ %>

                                    <a href="/resources?casePage=<%= caseStudies.page %>&whitePage=<%= whitepapers.page %>&blogPage=<%= i %>"
                                        class="<%= blogs.page === i ? 'active' : '' %>">
                                        <%= i %>
                                    </a>

                                        <% } %>

                                </div>

                                <% } %>

    </div>

</section>

