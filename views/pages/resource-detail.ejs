<% if(false){ %>
<section class="resource-banner">

    <div class="container">

        <img
            src="<%= blog.bannerImage %>"
            alt="<%= blog.title %>">

    </div>

</section>

<% } %>
<section class="resource-header">

    <div class="container">

        <div class="resource-type">

            <%= blog.type.replace("_"," ") %>

        </div>

        <h1 class="resource-title">

            <%= blog.title %>

        </h1>

        <% if(blog.excerpt){ %>

            <p class="resource-excerpt">

                <%= blog.excerpt %>

            </p>

        <% } %>

        <div class="resource-meta">

            <span>RainMan</span>

            <span>•</span>

            <span><%= blog.readingTime %> min read</span>

            <span>•</span>

            <span>

                <%= new Date(blog.publishedAt).toLocaleDateString("en-US",{
                    year:"numeric",
                    month:"long",
                    day:"numeric"
                }) %>

            </span>

        </div>

    </div>

</section>
<section class="resource-body">

    <div class="container">

        <article class="resource-content">

            <%- blog.contentHtml %>

        </article>

    </div>

</section>