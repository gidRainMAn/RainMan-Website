<table class="blog-table">

    <thead>

        <tr>

            <th>Banner</th>

            <th>Title</th>

            <th>Type</th>

            <th>Category</th>

            <th>Status</th>

            <th>Published</th>

            <th>Featured</th>

            <th>Actions</th>

        </tr>

    </thead>

    <tbody>

    <% blogs.forEach(blog => { %>

        <tr>

            <td>

                <img
                    src="<%= blog.bannerImage || '/images/no-image.png' %>"
                    alt="<%= blog.title %>"
                >

            </td>

            <td>

                <strong><%= blog.title %></strong>

            </td>

            <td>

                <span class="resource-type">

                    <%= (blog.type || "BLOG")
                        .replace("_", " ") %>

                </span>

            </td>

            <td>

                <%= blog.category?.name || "--" %>

            </td>

            <td>

                <span class="status <%= blog.status %>">

                    <%= blog.status %>

                </span>

            </td>

            <td>

                <%= blog.publishedAt
                    ? blog.publishedAt.toLocaleDateString()
                    : "--" %>

            </td>

            <td>

                <%= blog.featured ? "⭐ Featured" : "--" %>

            </td>

            <td>

                <div class="actions">

                    <a
                        href="/resources/<%= blog.slug %>"
                        class="btn secondary"
                        target="_blank"
                    >
                        Preview
                    </a>

                    <a
                        href="/admin/blogs/edit/<%= blog.id %>"
                        class="btn-sm primary"
                    >
                        Edit
                    </a>

                    <form
                        action="/admin/blogs/status/<%= blog.id %>"
                        method="POST"
                        style="display:inline;"
                    >

                        <input
                            type="hidden"
                            name="status"
                            value="<%= blog.status === 'PUBLISHED'
                                ? 'ARCHIVED'
                                : 'PUBLISHED' %>"
                        >

                        <button
                            type="submit"
                            class="btn-sm success"
                        >

                            <%= blog.status === "PUBLISHED"
                                ? "Archive"
                                : "Publish" %>

                        </button>

                    </form>

                    <form
                        action="/admin/blogs/delete/<%= blog.id %>"
                        method="POST"
                        style="display:inline;"
                        onsubmit="return confirm('Delete this resource?');"
                    >

                        <button
                            type="submit"
                            class="btn-sm danger"
                        >

                            Delete

                        </button>

                    </form>

                </div>

            </td>

        </tr>

    <% }) %>

    </tbody>

</table>