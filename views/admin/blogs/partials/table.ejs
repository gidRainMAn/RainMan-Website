<table class="blog-table">

    <thead>

        <tr>

            <th>Resource</th>
            <th>Type</th>
            <th>Category</th>
            <th>Status</th>
            <th>Published</th>
            <th>Featured</th>
            <th>Actions</th>

        </tr>

    </thead>

    <tbody>

        <% blogs.forEach(blog => { %>

        <tr>

            <td>

                <div class="resource-info">

                    <div class="resource-thumb">

                        <img
                            src="<%= blog.bannerImage || '/images/no-image.png' %>"
                            alt="<%= blog.title %>"
                        >

                    </div>

                    <div class="resource-details">

                        <strong>

                            <%= blog.title %>

                        </strong>

                        <small>

                            <%= blog.slug %>

                        </small>

                    </div>

                </div>

            </td>

            <td>

                <span class="resource-badge">

                    <%= (blog.type || "BLOG").replace("_"," ") %>

                </span>

            </td>

            <td>

                <%= blog.category?.name || "--" %>

            </td>

            <td>

                <span class="status <%= blog.status %>">

                    <%= blog.status %>

                </span>

            </td>

            <td>

                <%= blog.publishedAt
                    ? blog.publishedAt.toLocaleDateString()
                    : "--" %>

            </td>

            <td class="featured-col">

                <% if(blog.featured){ %>

                    ⭐

                <% } else { %>

                    —

                <% } %>

            </td>

            <td>

                <div class="actions">

                    <a
                        href="/resources/<%= blog.slug %>"
                        class="btn secondary"
                        target="_blank">

                        Preview

                    </a>

                    <a
                        href="/admin/blogs/edit/<%= blog.id %>"
                        class="btn-sm primary">

                        Edit

                    </a>

                    <form
                        action="/admin/blogs/status/<%= blog.id %>"
                        method="POST"
                        style="display:inline;">

                        <input
                            type="hidden"
                            name="status"
                            value="<%= blog.status === 'PUBLISHED'
                                ? 'ARCHIVED'
                                : 'PUBLISHED' %>">

                        <button
                            class="btn-sm success"
                            type="submit">

                            <%= blog.status==="PUBLISHED"
                                ? "Archive"
                                : "Publish" %>

                        </button>

                    </form>

                    <form
                        action="/admin/blogs/delete/<%= blog.id %>"
                        method="POST"
                        style="display:inline;"
                        onsubmit="return confirm('Delete this resource?');">

                        <button
                            class="btn-sm danger"
                            type="submit">

                            Delete

                        </button>

                    </form>

                </div>

            </td>

        </tr>

        <% }) %>

    </tbody>

</table>