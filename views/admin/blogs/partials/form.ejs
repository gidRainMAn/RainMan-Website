<%
    errors = errors || {};
%>
<h1>
    <%= blog ? "Edit Resource" : "Create Resource" %>
</h1>

<form
    action="<%= action %>"
    method="POST"
    enctype="multipart/form-data"
>

    <!-- Title -->

    <div class="form-group">

        <label>Title</label>

        <input
            type="text"
            name="title"
            value="<%= blog?.title || '' %>"
            class="<%= errors.title ? 'error-input' : '' %>"
        >

        <% if(errors.title){ %>

            <small class="error">

                <%= errors.title.msg %>

            </small>

        <% } %>
    </div>

    <div class="form-group">

        <label>Resource Type</label>

        <select name="type">

            <option
                value="BLOG"
                <%= blog?.type === "BLOG" ? "selected" : "" %>>
                Blog
            </option>

            <option
                value="CASE_STUDY"
                <%= blog?.type === "CASE_STUDY" ? "selected" : "" %>>
                Case Study
            </option>

            <option
                value="WHITEPAPER"
                <%= blog?.type === "WHITEPAPER" ? "selected" : "" %>>
                Whitepaper
            </option>

        </select>

    </div>

    <!-- Slug -->

    <div class="form-group">

        <label>Slug</label>

        <input
            type="text"
            name="slug"
            value="<%= blog?.slug || '' %>"
        >

        <small>
            Leave blank to auto-generate.
        </small>

    </div>

    <!-- Excerpt -->

    <div class="form-group">

        <label>Excerpt</label>

        <textarea
            name="excerpt"
            rows="4"
            class="<%= errors.excerpt ? 'error-input' : '' %>"
        ><%= blog?.excerpt || '' %></textarea>

        <% if (errors.excerpt) { %>
            <small class="error">
                <%= errors.excerpt.msg %>
            </small>
        <% } %>

    </div>

    <!-- Banner -->

    <div class="form-group">

        <label>Banner Image</label>

        <input
            type="file"
            name="banner"
            accept="image/*"
        >


        <% if(blog?.bannerImage){ %>

            <div class="current-banner">

                <p>Current Banner</p>

                <img
                    src="<%= blog.bannerImage %>"
                    alt="Current Banner"
                    class="banner-preview"
                >

            </div>

        <% } %>

    </div>

    <!-- Category -->

    <div class="form-group">

        <label>Category</label>

        <select
            name="categoryId"
            class="<%= errors.categoryId ? 'error-input' : '' %>"
        >
            <option value="">
                Select Category
            </option>
            <% categories.forEach(category => { %>

            <option
                value="<%= category.id %>"
                <%= blog?.categoryId === category.id ? "selected" : "" %>
            >
                <%= category.name %>
            </option>

            <% }) %>
            <% if (errors.categoryId) { %>
                <small class="error">
                    <%= errors.categoryId.msg %>
                </small>
            <% } %>
        </select>

    </div>

    <!-- Featured -->

    <div class="form-group checkbox">

        <label>

            <input
                type="checkbox"
                name="featured"
                value="true"

                <%= blog?.featured ? "checked" : "" %>
            >

            Featured Resource

        </label>

    </div>

    <!-- SEO -->

    <h3>SEO</h3>

    <div class="form-group">

        <label>SEO Title</label>

        <input
            type="text"
            name="seoTitle"
            value="<%= blog?.seoTitle || '' %>"
            class="<%= errors.seoTitle ? 'error-input' : '' %>"
        >

        <% if (errors.seoTitle) { %>
            <small class="error">
                <%= errors.seoTitle.msg %>
            </small>
        <% } %>

    </div>

    <div class="form-group">

        <label>SEO Description</label>

        <textarea
            name="seoDescription"
            rows="3"
            class="<%= errors.seoDescription ? 'error-input' : '' %>"
        ><%= blog?.seoDescription || '' %></textarea>

        <% if (errors.seoDescription) { %>
            <small class="error">
                <%= errors.seoDescription.msg %>
            </small>
        <% } %>

    </div>

    <!-- Content -->

    <h3>Content</h3>

    <div class="form-group">

        <label>Content</label>

        <div id="editor">
            <%- blog?.contentHtml || "" %>
        </div>

        <textarea
            id="contentHtml"
            name="contentHtml"
            hidden
            class="<%= errors.contentHtml ? 'error-input' : '' %>"
        ><%= blog?.contentHtml || "" %></textarea>

        <% if (errors.contentHtml) { %>
            <small class="error">
                <%= errors.contentHtml.msg %>
            </small>
        <% } %>

    </div>

    <!-- Buttons -->

    <div class="form-actions">

        <button
            type="submit"
            name="status"
            value="DRAFT"
            class="btn secondary"
        >

            Save Draft

        </button>

        <button
            type="submit"
            name="status"
            value="PUBLISHED"
            class="btn"
        >

            Publish

        </button>

    </div>

</form>